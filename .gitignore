# ============================================================
#  InvoiceFi – Root .gitignore
#  Covers: backend (Django), frontend (Vite/React), blockchain (Hardhat)
# ============================================================
**/.history/
# ────────────────────────────────────────────────────────────
#  Environment files – NEVER commit secrets
# ────────────────────────────────────────────────────────────
.env
.env.*
!.env.example          # allow the example template to be committed

# ────────────────────────────────────────────────────────────
#  BACKEND  (Django / Python)
# ────────────────────────────────────────────────────────────
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/**/*.pyd
backend/db.sqlite3
backend/*.log
backend/staticfiles/
backend/mediafiles/
backend/.pytest_cache/
backend/.mypy_cache/

# ────────────────────────────────────────────────────────────
#  FRONTEND  (Vite / React)
# ────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.history/
frontend/*.local
frontend/coverage/

# Logs
frontend/logs/
frontend/*.log
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# Editor
frontend/.vscode/*
!frontend/.vscode/extensions.json
frontend/.idea/
frontend/.DS_Store

# ────────────────────────────────────────────────────────────
#  BLOCKCHAIN  (Hardhat / Node)
# ────────────────────────────────────────────────────────────
blockchain/node_modules/
blockchain/artifacts/
blockchain/cache/
blockchain/coverage/
blockchain/coverage.json
blockchain/typechain/
blockchain/typechain-types/
blockchain/*.log
blockchain/compile2.txt
blockchain/compile_out.txt

# ────────────────────────────────────────────────────────────
#  OS / Editor junk (global)
# ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
